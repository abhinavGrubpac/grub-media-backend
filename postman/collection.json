        {
          "name": "Export Adverts CSV",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/adverts/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "adverts",
                "export"
              ]
            },
            "description": "Returns text/csv attachment."
          },
          "response": []
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/adverts/{{advertId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "adverts",
                "{{advertId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAUSED\",\n  \"expected_status\": \"LIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
