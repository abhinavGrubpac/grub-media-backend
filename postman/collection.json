              ],
              "path": [
                "api",
                "v1",
                "auth",
                "profile",
                "otp-verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\",\n  \"value\": \"new-address@grubpac.com\",\n  \"code\": \"1234\"\n}"
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/profile/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "profile",
                "password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Str0ngPass1\",\n  \"newPassword\": \"NewStr0ngPass1\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
