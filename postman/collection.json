            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/finalize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives",
                "finalize"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand_id\": \"{{brandId}}\",\n  \"name\": \"Festive Ad\",\n  \"s3_key\": \"creatives/123-Festive-Ad.png\",\n  \"media_type\": \"Image\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "creative_id OR brand_id+name, plus s3_key*, media_type*"
          },
          "response": []
        },
        {
          "name": "Create Creative",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand_id\": \"{{brandId}}\",\n  \"creative_name\": \"Festive Ad\",\n  \"external_ref_id\": \"EXT-001\",\n  \"initial_version\": {\n    \"media_url\": \"https://bucket/creatives/123.png\",\n    \"media_type\": \"Image\",\n    \"notes\": \"First version\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "brand_id*, creative_name*, external_ref_id, initial_version{media_url, media_type, notes}"
          },
          "response": []
        },
        {
          "name": "Upload Version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/{{creativeId}}/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives",
                "{{creativeId}}",
                "version"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"media_url\": \"https://bucket/creatives/124.png\",\n  \"media_type\": \"Image\",\n  \"notes\": \"Round 2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "media_url*, media_type*, notes"
          },
          "response": []
        },
        {
          "name": "Take Action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/{{versionId}}/action",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives",
                "{{versionId}}",
                "action"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\",\n  \"comments\": \"Compliant\",\n  \"expectedVersion\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "action* (APPROVE|REJECT|HOLD|REQUEST_CHANGES|RESUME); comments mandatory for REJECT/REQUEST_CHANGES; expectedVersion optimistic lock"
          },
          "response": []
        },
        {
          "name": "Upload Media (single-call)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives",
                "media"
              ]
            },
            "description": "multipart file=image/jpeg|png (25MB) + fields creative_id|brand_id+name. In Postman use form-data body type 'file'."
          }
        },
        {
          "name": "Take Action (legacy alias)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/version/{{versionId}}/action",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives",
                "version",
                "{{versionId}}",
                "action"
              ]
            },
            "description": "action* (APPROVE|REJECT|HOLD|REQUEST_CHANGES|RESUME); comments mandatory for REJECT/REQUEST_CHANGES; expectedVersion optimistic lock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\",\n  \"comments\": \"Compliant\",\n  \"expectedVersion\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Adverts",
      "description": "Advert monitoring endpoints. Deployments originate upstream (intake); government side monitors and changes status.",
      "item": [
        {
          "name": "Radius Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/adverts/search?lat=28.6139&lng=77.209&radius=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "adverts",
                "search"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "28.6139"
                },
                {
                  "key": "lng",
                  "value": "77.209"
                },
                {
                  "key": "radius",
                  "value": "5",
                  "description": "km, needs lat+lng"
                },
                {
                  "key": "brand_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "industry",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Without lat/lng falls back to a plain filtered list."
          },
          "response": []
        },
        {
          "name": "Recent Searches",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/adverts/searches/recent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "adverts",
                "searches",
                "recent"
              ]
            },
            "description": "7-day revisit window: this operator's recent searches, newest first."
          },
          "response": []
        },
        {
          "name": "Reverse-Image Search",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/adverts/search/by-image?max_distance=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "adverts",
                "search",
                "by-image"
              ],
              "query": [
                {
                  "key": "max_distance",
                  "value": "10"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "image.png",
                  "description": "PNG or JPEG query image"
                }
              ]
            },
            "description": "Upload PNG/JPEG; matches by dHash Hamming distance, nearest first. Exact duplicates land at distance 0."
          },
          "response": []
        },
        {
          "name": "List Adverts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/adverts?page=1&limit=20",
