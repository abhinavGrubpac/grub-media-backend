            }
          },
          "response": []
        },
        {
          "name": "Upload Version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/{{creativeId}}/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives",
                "{{creativeId}}",
                "version"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"media_url\": \"agency/{{brandId}}/file-v2.png\",\n  \"media_type\": \"Image\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Take Action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/{{versionId}}/action",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives",
                "{{versionId}}",
                "action"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\",\n  \"comments\": \"Compliant\"\n}"
            },
            "description": "action: APPROVE | REJECT | HOLD | REQUEST_CHANGES | RESUME. Comments mandatory for REJECT/REQUEST_CHANGES."
          },
          "response": []
        },
        {
          "name": "Upload Media (single-call)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/media"
            },
            "description": "multipart file=image/jpeg|png (25MB) + fields creative_id|brand_id+name. In Postman use form-data body type 'file'."
          }
        },
        {
          "name": "Take Action (legacy alias)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/version/{{versionId}}/action"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
