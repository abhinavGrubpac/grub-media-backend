{
  "info": {
    "name": "grub-media-backend — Authentication",
    "description": "Authentication endpoints only. Login and refresh requests save the returned access and refresh tokens to the active Postman environment. Protected requests use {{accessToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login — Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@grubpac.com\",\n  \"password\": \"Str0ngPass1\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('login returns 200', () => pm.response.to.have.status(200));", "const data = pm.response.json().data;", "if (data?.accessToken) pm.environment.set('accessToken', data.accessToken);", "if (data?.refreshToken) pm.environment.set('refreshToken', data.refreshToken);"] } }]
        },
        {
          "name": "Refresh Tokens",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('refresh returns 200', () => pm.response.to.have.status(200));", "const data = pm.response.json().data;", "if (data?.accessToken) pm.environment.set('accessToken', data.accessToken);", "if (data?.refreshToken) pm.environment.set('refreshToken', data.refreshToken);"] } }]
        },
        {
          "name": "Login — Request OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login/otp-request", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login", "otp-request"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@grubpac.com\"\n}" },
            "description": "Requests a 4-digit login code by email. The response is the same whether or not the account exists."
          }
        },
        {
          "name": "Login — Verify OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login/otp-verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login", "otp-verify"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@grubpac.com\",\n  \"code\": \"1234\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('OTP login returns 200', () => pm.response.to.have.status(200));", "const data = pm.response.json().data;", "if (data?.accessToken) pm.environment.set('accessToken', data.accessToken);", "if (data?.refreshToken) pm.environment.set('refreshToken', data.refreshToken);"] } }]
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@grubpac.com\"\n}" },
            "description": "Requests a password reset link. The response does not reveal whether the account exists."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<token-from-email-link>\",\n  \"password\": \"NewStr0ngPass1\"\n}" }
          }
        },
        {
          "name": "Get Current User",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] } }
        },
        {
          "name": "Request Profile Verification OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/profile/otp-request", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "profile", "otp-request"] },
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"email\",\n  \"value\": \"new-address@grubpac.com\"\n}" },
            "description": "Request a verification code for a new email or phone number. Set type to email or phone."
          }
        },
        {
          "name": "Verify Profile OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/profile/otp-verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "profile", "otp-verify"] },
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"email\",\n  \"value\": \"new-address@grubpac.com\",\n  \"code\": \"1234\"\n}" }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/profile/password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "profile", "password"] },
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Str0ngPass1\",\n  \"newPassword\": \"NewStr0ngPass1\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] } }
        }
      ]
    }
  ]
}
