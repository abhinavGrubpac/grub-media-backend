                "v1",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Creative Review",
      "description": "Creative review endpoints. NOTE: static GET routes (export, filter-options) must stay registered before :id/history and :id in ReviewController, or filter-options is captured as :id.",
      "item": [
        {
          "name": "List Creatives",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "creatives"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "PENDING",
                  "disabled": true
                },
                {
                  "key": "brand_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Paginated list. Filters: status, brand_id, search, industry, startDate, endDate, actor_id, sortBy, include=history, ids."
          },
          "response": []
        },
        {
          "name": "Export Creatives CSV",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/export",
