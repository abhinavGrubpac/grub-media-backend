            "description": "Returns text/csv attachment."
          },
          "response": []
        },
        {
          "name": "Filter Options",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/creatives/filter-options",
              "host": [
