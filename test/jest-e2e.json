{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1"
  },
  "setupFiles": ["reflect-metadata", "<rootDir>/env-e2e.ts"],
  "globalSetup": "<rootDir>/global-setup-e2e.ts",
  "testTimeout": 30000
}
