// GrubPac Media Backend — Prisma schema
// Migrations: `prisma migrate dev` locally, `prisma migrate deploy` on release.
// Never use `prisma db push` for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  PROFILE_EMAIL
  PROFILE_PHONE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  phoneNumber         String?
  logoUrl             String?
  employeeId          String               @default("")
  organizationName    String?
  organizationId      String?
  jurisdiction        String?
  role                UserRole             @default(EMPLOYEE)
  status              UserStatus           @default(ACTIVE)
  tokenVersion        Int                  @default(0)
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  bundleAssignments  UserBundle[]
  managedEmployees   AdminEmployeeAssignment[] @relation("AdminEmployees")
  adminAssignment    AdminEmployeeAssignment? @relation("EmployeeAdmin")

  @@index([deletedAt])
}

model Permission {
  id String @id @default(cuid())
  module String
  page String
  action String
  custom Boolean @default(false)
  createdAt DateTime @default(now())
  bundlePermissions BundlePermission[]
  @@unique([module, page, action])
}
model PermissionBundle {
  id String @id @default(cuid())
  name String
  description String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  permissions BundlePermission[]
  users UserBundle[]
  @@unique([createdBy, name])
}
model BundlePermission {
  bundleId String
  permissionId String
  bundle PermissionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([bundleId, permissionId])
}
model UserBundle {
  userId String
  bundleId String
  assignedBy String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle PermissionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  @@id([userId, bundleId])
}
model AdminEmployeeAssignment {
  employeeId String @unique
  adminId String
  assignedBy String
  createdAt DateTime @default(now())
  admin User @relation("AdminEmployees", fields: [adminId], references: [id], onDelete: Cascade)
  employee User @relation("EmployeeAdmin", fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([adminId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken  String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model HelpCategory {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  /// S3 object key/path (e.g. help/categories/attendance.png) — never the binary.
  icon         String?
  displayOrder Int?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  faqs         HelpFaq[]

  @@index([isActive, displayOrder])
  @@map("help_categories")
}

model HelpFaq {
  id           Int          @id @default(autoincrement())
  categoryId   Int
  category     HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question     String
  answer       String
  isActive     Boolean      @default(true)
  displayOrder Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categoryId, isActive])
  @@map("help_faqs")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  requestId  String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// GrubPac domain — managed brands (identity synced from upstream, compliance
// overlay owned by this portal; see docs/superpowers domain modules spec)
// ---------------------------------------------------------------------------

model Brand {
  id               String      @id @default(cuid())
  brandName        String      @unique
  industryCategory String?
  contactEmail     String?
  isActive         Boolean     @default(true)
  autoApprove      Boolean     @default(false)
  isFlagged        Boolean     @default(false)
  upstreamBrandId  String?     @unique
  upstreamAgencyId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  creatives        Creative[]

  @@index([upstreamAgencyId])
}

model AgencyRef {
  id               String   @id @default(cuid())
  upstreamAgencyId String   @unique
  agencyName       String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  syncedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// GrubPac domain — creative review
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  ON_HOLD
  NEEDS_CHANGES
  WITHDRAWN
}

enum ActionType {
  APPROVE
  REJECT
  HOLD
  REQUEST_CHANGES
}

model Creative {
  id                 String            @id @default(cuid())
  brandId            String
  brand              Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creativeName       String
  externalRefId      String?
  currentVersionId   String?
  upstreamCreativeId String?           @unique
  upstreamAgencyId   String?
  campaignRef        String?
  createdAt          DateTime          @default(now())
  versions           CreativeVersion[]

  @@index([brandId])
}

model CreativeVersion {
  id                String              @id @default(cuid())
  creativeId        String
  creative          Creative            @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  versionNumber     Int
  mediaUrl          String
  mediaType         String
  status            ReviewStatus        @default(PENDING)
  createdBy         String
  upstreamVersionId String?             @unique
  submittedAt       DateTime?
  createdAt         DateTime            @default(now())
  actions           ReviewAction[]
  adverts           Advert[]
  references        CreativeReference[]

  @@index([creativeId])
  @@index([status])
}

model ReviewAction {
  id        String          @id @default(cuid())
  versionId String
  version   CreativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  actorId   String
  action    ActionType
  comments  String?
  createdAt DateTime        @default(now())

  @@index([versionId])
}

// ---------------------------------------------------------------------------
// GrubPac domain — reference documents (soft archive only, never delete)
// ---------------------------------------------------------------------------

model ReferenceDoc {
  id            String             @id @default(cuid())
  title         String
  fileUrl       String
  category      String
  description   String?
  publishedOn   DateTime?
  isArchived    Boolean            @default(false)
  archivedOn    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  creativeLinks CreativeReference[]

  @@index([category])
}

model CreativeReference {
  versionId String
  version   CreativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  docId     String
  doc       ReferenceDoc    @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@id([versionId, docId])
}

// ---------------------------------------------------------------------------
// GrubPac domain — advert control (PostGIS location; Prisma Client cannot
// create/update rows with Unsupported columns, writes go through raw SQL)
// ---------------------------------------------------------------------------

enum AdvertStatus {
  SCHEDULED
  LIVE
  PAUSED
  EXPIRED
  REVOKED
}

model Advert {
  id               String          @id
  versionId        String
  version          CreativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  location         Unsupported("geometry(Point, 4326)")
  addressText      String?
  status           AdvertStatus    @default(SCHEDULED)
  startDate        DateTime
  endDate          DateTime
  imageHash        String?
  upstreamAdvertId String?         @unique
  cityName         String?
  zoneName         String?
  createdAt        DateTime        @default(now())

  @@index([versionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// GrubPac domain — kafka event backbone (transactional outbox + read models)
// ---------------------------------------------------------------------------

model OutboxEvent {
  id        String    @id
  topic     String
  key       String
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  attempts  Int       @default(0)
  lastError String?
  failedAt  DateTime?

  @@index([sentAt, createdAt])
}

model ProcessedEvent {
  eventId     String
  consumer    String
  topic       String
  processedAt DateTime @default(now())

  @@id([eventId, consumer])
  @@index([processedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemLog {
  id         BigInt   @id @default(autoincrement())
  level      String
  module     String
  message    String
  stackTrace String?
  timestamp  DateTime @default(now())

  @@index([timestamp])
}

model DashboardSnapshot {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, purpose, usedAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
