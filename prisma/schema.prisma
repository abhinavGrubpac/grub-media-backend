// GrubPac Media Backend — Prisma schema
// Migrations: `prisma migrate dev` locally, `prisma migrate deploy` on release.
// Never use `prisma db push` for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  PROFILE_EMAIL
  PROFILE_PHONE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  phoneNumber         String?
  logoUrl             String?
  employeeId          String               @default("")
  organizationName    String?
  organizationId      String?
  role                UserRole             @default(EMPLOYEE)
  status              UserStatus           @default(ACTIVE)
  tokenVersion        Int                  @default(0)
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  bundleAssignments  UserBundle[]
  managedEmployees   AdminEmployeeAssignment[] @relation("AdminEmployees")
  adminAssignment    AdminEmployeeAssignment? @relation("EmployeeAdmin")

  @@index([deletedAt])
}

model Permission {
  id String @id @default(cuid())
  module String
  page String
  action String
  custom Boolean @default(false)
  createdAt DateTime @default(now())
  bundlePermissions BundlePermission[]
  @@unique([module, page, action])
}
model PermissionBundle {
  id String @id @default(cuid())
  name String
  description String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  permissions BundlePermission[]
  users UserBundle[]
  @@unique([createdBy, name])
}
model BundlePermission {
  bundleId String
  permissionId String
  bundle PermissionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([bundleId, permissionId])
}
model UserBundle {
  userId String
  bundleId String
  assignedBy String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle PermissionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  @@id([userId, bundleId])
}
model AdminEmployeeAssignment {
  employeeId String @unique
  adminId String
  assignedBy String
  createdAt DateTime @default(now())
  admin User @relation("AdminEmployees", fields: [adminId], references: [id], onDelete: Cascade)
  employee User @relation("EmployeeAdmin", fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([adminId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken  String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model HelpCategory {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  /// S3 object key/path (e.g. help/categories/attendance.png) — never the binary.
  icon         String?
  displayOrder Int?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  faqs         HelpFaq[]

  @@index([isActive, displayOrder])
  @@map("help_categories")
}

model HelpFaq {
  id           Int          @id @default(autoincrement())
  categoryId   Int
  category     HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question     String
  answer       String
  isActive     Boolean      @default(true)
  displayOrder Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categoryId, isActive])
  @@map("help_faqs")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  requestId  String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, purpose, usedAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
