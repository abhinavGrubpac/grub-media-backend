generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole             @default(EMPLOYEE)
  status              UserStatus           @default(ACTIVE)
  tokenVersion        Int                  @default(0)
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]

  @@index([deletedAt])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  hashedToken  String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HelpCategory {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  /// S3 object key/path (e.g. help/categories/attendance.png) — never the binary.
  icon         String?
  displayOrder Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  faqs         HelpFaq[]

  @@index([isActive, displayOrder])
  @@map("help_categories")
}

model HelpFaq {
  id           Int          @id @default(autoincrement())
  categoryId   Int
  question     String
  answer       String
  isActive     Boolean      @default(true)
  displayOrder Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  category     HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isActive])
  @@map("help_faqs")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  requestId  String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
}

/// Log System (see `logs Grubmedia .drawio.pdf`): one row per recorded event.
/// FKs are nullable + SetNull so a log row is never blocked by taxonomy changes
/// and history survives category/action deletion.
model Log {
  id          Int          @id @default(autoincrement())
  typeEnum    LogType
  categoryId  Int?
  actionId    Int?
  actionText  String?
  userId      String?
  empId       String?
  oldDetail   String?
  newDetail   String?
  referenceId String?
  createdAt   DateTime     @default(now())
  action      LogAction?   @relation(fields: [actionId], references: [id])
  category    LogCategory? @relation(fields: [categoryId], references: [id])

  @@index([typeEnum, createdAt], map: "idx_type_date")
  @@index([categoryId], map: "idx_category")
  @@index([actionId], map: "idx_action")
  @@index([userId], map: "idx_user")
  @@index([typeEnum, categoryId, createdAt], map: "idx_type_cat_date")
  @@map("log")
}

model LogCategory {
  id       Int         @id @default(autoincrement())
  typeEnum LogType
  name     String
  /// S3 object key/path — never the binary.
  image    String?
  logs     Log[]
  actions  LogAction[]

  @@unique([name, typeEnum], map: "uk_name_type")
  @@index([typeEnum], map: "idx_log_type")
  @@map("log_categories")
}

model LogAction {
  id         Int         @id @default(autoincrement())
  categoryId Int
  name       String
  logs       Log[]
  category   LogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([name, categoryId], map: "uk_name_category")
  @@index([categoryId], map: "idx_action_category")
  @@map("log_action")
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  hashedToken String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
}

/// Log stream discriminator — matches the `type_enum` column of the log,
/// log_categories and log_action tables (Log System design).
enum LogType {
  SYSTEM
  ACTIVITY
  EMPLOYEE
}
