generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  PROFILE_EMAIL
  PROFILE_PHONE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  phoneNumber         String?
  avatarUrl           String?
  employeeId          String               @default("")
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  jurisdiction        String?
  joiningDate         DateTime?
  role                UserRole             @default(EMPLOYEE)
  status              UserStatus           @default(ACTIVE)
  tokenVersion        Int                  @default(0)
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  bundleAssignments  UserBundle[]
  managedEmployees   AdminEmployeeAssignment[] @relation("AdminEmployees")
  adminAssignment    AdminEmployeeAssignment? @relation("EmployeeAdmin")

  @@index([deletedAt])
  @@index([organizationId])
}

model Organization {
  id           String    @id @default(cuid())
  name         String
  regNumber    String?   @unique
  logoUrl      String?
  jurisdiction String?
  status       OrgStatus @default(ACTIVE)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  users        User[]

  @@index([deletedAt])
}

model Permission {
  id                String             @id @default(cuid())
  module            String
  page              String
  action            String
  label             String?
  custom            Boolean            @default(false)
  createdAt         DateTime           @default(now())
  bundlePermissions BundlePermission[]

  @@unique([module, page, action])
}
model PermissionBundle {
  id String @id @default(cuid())
  name String
  description String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  permissions BundlePermission[]
  users UserBundle[]
  @@unique([createdBy, name])
}
model BundlePermission {
  bundleId String
  permissionId String
  bundle PermissionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([bundleId, permissionId])
}
model UserBundle {
  userId String
  bundleId String
  assignedBy String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle PermissionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  @@id([userId, bundleId])
}
model AdminEmployeeAssignment {
  employeeId String @unique
  adminId String
  assignedBy String
  createdAt DateTime @default(now())
  admin User @relation("AdminEmployees", fields: [adminId], references: [id], onDelete: Cascade)
  employee User @relation("EmployeeAdmin", fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([adminId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  hashedToken  String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HelpCategory {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  /// S3 object key/path (e.g. help/categories/attendance.png) — never the binary.
  icon         String?
  displayOrder Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  faqs         HelpFaq[]

  @@index([isActive, displayOrder])
  @@map("help_categories")
}

model HelpFaq {
  id           Int          @id @default(autoincrement())
  categoryId   Int
  question     String
  answer       String
  isActive     Boolean      @default(true)
  displayOrder Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  category     HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isActive])
  @@map("help_faqs")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  requestId  String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
}

/// Log System (see `logs Grubmedia .drawio.pdf`): one row per recorded event.
/// The action name is denormalized onto the row (`actionName`) — there is no
/// separate action taxonomy table; the category FK stays nullable + SetNull
/// so a log row is never blocked by category changes.
model Log {
  id         Int          @id @default(autoincrement())
  typeEnum   LogType
  categoryId Int?
  /// Denormalized action name, e.g. 'Login', 'Create Employee'.
  actionName String?
  actionText String?
  userId     String?
  empId      String?
  oldDetail  String?
  newDetail  String?
  createdAt  DateTime     @default(now())
  category   LogCategory? @relation(fields: [categoryId], references: [id])

  @@index([typeEnum, createdAt], map: "idx_type_date")
  @@index([categoryId], map: "idx_category")
  @@index([typeEnum, actionName], map: "idx_type_action")
  @@index([userId], map: "idx_user")
  @@index([typeEnum, categoryId, createdAt], map: "idx_type_cat_date")
  @@map("log")
}

model LogCategory {
  id       Int         @id @default(autoincrement())
  typeEnum LogType
  name     String
  /// S3 object key/path — never the binary.
  image    String?
  logs     Log[]

  @@unique([name, typeEnum], map: "uk_name_type")
  @@index([typeEnum], map: "idx_log_type")
  @@map("log_categories")
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  hashedToken String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Log stream discriminator — matches the `type_enum` column of the log,
/// log_categories and log_action tables (Log System design).
enum LogType {
  SYSTEM
  ACTIVITY
  EMPLOYEE
}
