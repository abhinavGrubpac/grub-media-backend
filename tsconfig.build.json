{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Keep the incremental state INSIDE dist/: nest-cli.json has
    // deleteOutDir:true, which wipes dist/ before each build. If the
    // tsbuildinfo lived at the project root it would survive the wipe and
    // tsc --watch would then report "0 errors" while emitting nothing —
    // leaving dist/ empty and `node dist/main` failing with MODULE_NOT_FOUND.
    // Placing it in dist/ makes the two get deleted together.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "prisma",
    "**/*spec.ts",
    // Scratch/diagnostic scripts (e.g. probe.tmp.ts) written at the project
    // root. rootDir is "src", so any root-level .ts file would otherwise
    // trigger TS6059 ("not under rootDir"). Keeping them excluded lets a
    // temporary probe coexist with `tsc --watch` / `nest start --watch`
    // without breaking the build.
    "**/*.tmp.ts"
  ]
}
