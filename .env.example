# =============================================================
# GrubPac Media Backend — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file.
# =============================================================

# ── APP ──────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=3000
APP_NAME=grub-media-backend

# ── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/grubmedia?schema=public

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=changeme_use_at_least_32_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh_use_at_least_32_chars_xxxxxxxxxxxxxxxxx
JWT_REFRESH_EXPIRES_IN=7d

# ── REDIS ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ── RATE LIMITING / THROTTLE ─────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
THROTTLE_TTL=60
THROTTLE_LIMIT=100
