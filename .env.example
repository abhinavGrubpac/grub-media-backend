# =============================================================
# GrubPac Media Backend — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file.
# =============================================================

# ── APP ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=grub-media-backend

# ── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/grubmedia?schema=public

# ── JWT ──────────────────────────────────────────────────────
# Secrets MUST be at least 32 characters. Generate strong random values.
JWT_ACCESS_SECRET=changeme_access_use_at_least_32_chars_xxxxxxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changeme_refresh_use_at_least_32_chars_xxxxxxxxxx
JWT_REFRESH_TTL=7d

# ── REDIS ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── CONTACT ──────────────────────────────────────────────────
# Address returned by GET /api/help/contact (mailto: link for the frontend).
SUPPORT_EMAIL=support@grubpac.com

# ── RATE LIMITING / THROTTLE ─────────────────────────────────
# THROTTLE_TTL is in milliseconds (window), THROTTLE_LIMIT is max requests per window.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Max failed login attempts (per email+IP) before temporary lockout.
THROTTLE_LOGIN_LOCK_MAX=5

# ── SMTP / TRANSACTIONAL EMAIL ───────────────────────────────
# All SMTP vars are optional. If absent the app starts but email sends will fail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@grubpac.com
# Frontend base URL embedded in password reset links.
FRONTEND_URL=http://localhost:3000

# ── S3 / OBJECT STORAGE ──────────────────────────────────────
# All optional — app starts without them; POST /users/profile/avatar returns 500 if unset.
# Works with AWS S3, Cloudflare R2, MinIO, or LocalStack.
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=grubpac-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: custom endpoint for R2 (https://<accountid>.r2.cloudflarestorage.com),
# MinIO (http://localhost:9000), or LocalStack (http://localhost:4566).
AWS_S3_ENDPOINT=
# Optional: CloudFront distribution URL (no trailing slash).
# If set, public URLs use CDN instead of direct S3 endpoint.
AWS_CLOUDFRONT_URL=

# ── SEED (used by prisma/seed.ts; required to seed the super-admin) ──
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# ── KAFKA / REDPANDA (event backbone; defaults to localhost:9092) ──
# Comma-separated broker list.
REDPANDA_BROKERS=localhost:9092
REDPANDA_CLIENT_ID=grub-media-backend
# Optional SASL (scram-sha-256); setting a username enables TLS.
REDPANDA_SASL_USERNAME=
REDPANDA_SASL_PASSWORD=

# ── STORAGE (S3 media bucket; leave empty to run in local mock mode) ──
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
